


import numpy as np
from scipy.stats import norm
import matplotlib.pyplot as plt
from bsutils.funcs import blackScholes, build_bs_param_df

df = build_bs_param_df("^SPX", expiration_index=5, r=0.04, opt_type="C")


df.head()


row = df.iloc[0]

bs_price = blackScholes(
    r=row["r"],
    S=row["S"],
    K=row["K"],
    T=row["T"],
    sigma=row["sigma"],
    type=row["type"]
)

print(bs_price)


# I want to visualize the “heat equation / diffusion smoothing” intuition:
# at expiration the payoff has a sharp kink, and farther from expiration the BS value curve is smoother.

# parameters
K = 5600
r = 0.04
sigma = 0.20
opt_type = "C"

# pick a reasonable S range around the strike
S_min, S_max = 3500, 9000
S_grid = np.linspace(S_min, S_max, 600)

# a few different times-to-maturity (in years)
taus = [1/365, 7/365, 30/365, 90/365]

# payoff at expiration (the kink)
payoff = np.maximum(S_grid - K, 0)

plt.figure(figsize=(9, 5))
plt.plot(S_grid, payoff, linewidth=2, label=r"Payoff at expiry $(S-K)^+$")

# Black–Scholes value curves for different maturities (this shows the “smoothing”)
for tau in taus:
    V = np.array([blackScholes(r=r, S=S, K=K, T=tau, sigma=sigma, type=opt_type) for S in S_grid])
    plt.plot(S_grid, V, linewidth=2, label=fr"BS price, $\tau$ = {int(round(tau*365))} days")

plt.axvline(K, linewidth=2, linestyle="--", label="Strike K")
plt.title("Diffusion intuition: the payoff kink gets smoothed away from expiry")
plt.xlabel("Stock price S")
plt.ylabel("Option value V(S,t)")
plt.legend()
plt.show()



